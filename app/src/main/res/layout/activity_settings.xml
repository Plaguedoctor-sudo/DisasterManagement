<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Application Settings"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HARDWARE INTERFACE ACCESS"
            android:textColor="#00FF66"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#161616"
            android:padding="14dp"
            android:layout_marginBottom="20dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@+id/swSettingsBle">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bluetooth Low Energy"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Facilitates local beacon discovery and telemetry relay."
                        android:textColor="#888888"
                        android:textSize="11sp" />
                </LinearLayout>
                <Switch
                    android:id="@+id/swSettingsBle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@+id/swSettingsMic">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Acoustic Transceiver (Microphone)"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Receives high-frequency acoustic telemetry under heavy RF noise."
                        android:textColor="#888888"
                        android:textSize="11sp" />
                </LinearLayout>
                <Switch
                    android:id="@+id/swSettingsMic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@+id/swSettingsCam">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Optical Matrix Reader (Camera)"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Captures animated 2D matrix optical backup frames."
                        android:textColor="#888888"
                        android:textSize="11sp" />
                </LinearLayout>
                <Switch
                    android:id="@+id/swSettingsCam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true" />
            </RelativeLayout>

            <Button
                android:id="@+id/btnOpenOsSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="System Application Permissions"
                android:backgroundTint="#262626"
                android:textColor="#CCCCCC"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="COMPLIANCE &amp; SERVICE AGREEMENT"
            android:textColor="#00FF66"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#161616"
            android:padding="14dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Civil Disaster Telecommunication Standards"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Review the standard End-User License Agreement, unlicensed spectrum parameters, and data stewardship terms."
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnViewTermsOfUse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="View License Agreement &amp; Disclaimers"
                android:backgroundTint="#1F2937"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- STRICT AIR-GAP ENFORCEMENT & DATA SOVEREIGNTY -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STRICT AIR-GAP &amp; DATA SOVEREIGNTY"
            android:textColor="#00FF66"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#161616"
            android:padding="14dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Operational Security Mode"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STRICT AIR-GAP ENFORCED (Zero External Internet Connectivity)"
                android:textColor="#34D399"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Security &amp; Architectural Invariants:"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Cloud / WAN Egress: Permanently neutralized&#10;• Remote Servers / Endpoints: None (Zero remote dependencies)&#10;• On-Device Intelligence: 100% local memory-resident execution&#10;• Local Vault: AES-256 SQLCipher encrypted on-device database&#10;• Physical Transport: Peer-to-peer BLE &amp; Wi-Fi Direct only"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnAuditAirGapIntegrity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Verify Air-Gap Attestation"
                android:backgroundTint="#065F46"
                android:textColor="#ECFDF5" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
